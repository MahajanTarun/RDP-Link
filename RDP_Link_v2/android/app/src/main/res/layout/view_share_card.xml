<?xml version="1.0" encoding="utf-8"?>
<!-- Share-this-screen card. Included by the portrait, landscape and tablet
     layouts so every screen size keeps exactly the same spacing rules. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/OfficeCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/OfficeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Share this screen (Host)" />

    <TextView
        style="@style/OfficeBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="You share your screen; others connect to you." />

    <TextView
        style="@style/OfficeBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Start sharing from the bar below, then approve the screen capture prompt." />

    <TextView
        style="@style/OfficeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/label_gap"
        android:text="Access password" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/field_gap"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/password"
            style="@style/OfficeInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:hint="Required for guests"
            android:inputType="text" />

        <Button
            android:id="@+id/genPassword"
            style="@style/OfficeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/button_gap"
            android:text="New" />
    </LinearLayout>

    <TextView
        android:id="@+id/advancedToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/label_gap"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="Advanced settings ▾"
        android:textColor="@color/antd_primary"
        android:textSize="@dimen/label_text" />

    <LinearLayout
        android:id="@+id/advancedPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/OfficeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/field_gap"
            android:text="Listening port" />

        <EditText
            android:id="@+id/port"
            style="@style/OfficeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/field_gap"
            android:inputType="number"
            android:text="8088" />

        <TextView
            style="@style/OfficeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/label_gap"
            android:text="Rendezvous URL (WAN relay)" />

        <EditText
            android:id="@+id/rendezvous"
            style="@style/OfficeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/field_gap"
            android:hint="https://relay.example.com" />
    </LinearLayout>

    <Button
        android:id="@+id/enableA11y"
        style="@style/OfficeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/label_gap"
        android:text="Enable remote control (accessibility)" />

    <Button
        android:id="@+id/setupBtn"
        style="@style/OfficeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/button_gap"
        android:text="Setup &amp; permissions" />

    <TextView
        android:id="@+id/status"
        style="@style/OfficeTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/label_gap"
        android:text="Idle" />
</LinearLayout>
