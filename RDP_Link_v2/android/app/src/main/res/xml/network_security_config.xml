<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- LAN sharing uses plain HTTP on the local network. Guests still need the
         host password. For WAN deployments put the agent behind TLS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
